<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Boosted connects directly to user-managed LAN and remote servers. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
