{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boosted",
  "version": "0.2.4",
  "identifier": "app.boosted.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Boosted",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Transparent",
        "backgroundColor": "#0e0e0e",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data: blob:; script-src 'self' 'unsafe-eval'; connect-src 'self' ipc: http: https: ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExQTU1QjMyNzI2NUJDOUYKUldTZnZHVnlNbHVsb1NGSlhYQ3FLN0N5TlY0YW1Oc1JncjlLRWgrUk1WVXgzcnBPMk1PUjU2NFoK",
      "endpoints": [
        "https://github.com/monokaijs/boosted/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
