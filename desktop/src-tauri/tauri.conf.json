{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boosted",
  "version": "0.1.0",
  "identifier": "app.boosted.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Boosted",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data: blob:; script-src 'self' 'unsafe-eval'; connect-src 'self' ipc: http://127.0.0.1:4782 ws://127.0.0.1:4782"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
